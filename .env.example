GROQ_API_KEY="your api key"
JINA_API_KEY="your api key"

GROQ_CHAT_MODEL=qwen/qwen3.8-27b
JINA_EMBEDDING_MODEL=jina-embeddings-v2-base-en


# Vector database

# "faiss"    -> local files, no account needed (recommended for learning)
# "pinecone" -> remote vector database, needs the keys below
VECTOR_DB=faiss

# Only needed when VECTOR_DB=pinecone.
PINECONE_API_KEY="your api key"
PINECONE_INDEX_NAME=advanced-rag
PINECONE_NAMESPACE=default


PARENT_CHUNK_SIZE=1600
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=60

NUM_QUERY_VARIANTS=3
VECTOR_TOP_K=6
BM25_TOP_K=6
HYBRID_TOP_K=10
RERANK_TOP_K=4
MIN_RERANK_SCORE=-4.0
MAX_CONTEXT_CHARS=8000
MEMORY_WINDOW=4

# Reranker: "cross-encoder" (accurate, needs sentence-transformers + PyTorch)
# or "simple" (keyword overlap, no extra packages - use it if PyTorch will not
# install or load on your machine).
RERANKER=cross-encoder
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2